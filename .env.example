# ── FPL Credentials ────────────────────────────────────────────────────────────
# Your Fantasy Premier League login (same as premierleague.com login)
FPL_EMAIL=your.email@example.com
FPL_PASSWORD=your_password_here

# Your FPL manager/team ID (visible in your FPL team URL)
# e.g. https://fantasy.premierleague.com/entry/1234567/history → 1234567
FPL_TEAM_ID=1234567

# ── Bot Behaviour ───────────────────────────────────────────────────────────────
# Set to true to run full pipeline WITHOUT making real transfers (safe testing)
DRY_RUN=false

# Maximum transfer hit points the bot will accept per gameweek (default 8 = 2 hits)
MAX_HIT_PER_GW=8

# ── Notifications (optional) ───────────────────────────────────────────────────
# Discord webhook URL for action reports (leave blank to disable)
DISCORD_WEBHOOK_URL=

# Slack incoming webhook URL (leave blank to disable)
SLACK_WEBHOOK_URL=

# ── Scheduling ─────────────────────────────────────────────────────────────────
# Minutes before GW deadline to run the bot (default 60)
MINUTES_BEFORE_DEADLINE=60

# Timezone for logging (does not affect deadline calculation, which uses UTC)
TIMEZONE=Europe/London

# ── Database ───────────────────────────────────────────────────────────────────
# Path to SQLite database file
DATABASE_PATH=./fpl_bot.db

# ── Advanced ───────────────────────────────────────────────────────────────────
# Number of historical GWs used for self-improvement weight tuning (min 5)
LEARNER_HISTORY_GWS=10

# Number of future GWs to lookahead in optimisation (1-5)
LOOKAHEAD_GAMEWEEKS=3

# Decay factor for lookahead GW weighting (0-1)
LOOKAHEAD_DECAY=0.85
