# ── FPL Credentials ────────────────────────────────────────────────────────────
FPL_EMAIL=your.email@example.com
FPL_PASSWORD=your_password_here
FPL_TEAM_ID=1234567

# ── Always true for local dashboard ───────────────────────────────────────────
DRY_RUN=true

# ── Optional: Discord notifications (leave blank to disable) ──────────────────
DISCORD_WEBHOOK_URL=

# ── Analysis settings (editable via /settings UI) ─────────────────────────────
MAX_HIT_PER_GW=8
LOOKAHEAD_GAMEWEEKS=3
LOOKAHEAD_DECAY=0.85

# ── Chip thresholds ────────────────────────────────────────────────────────────
WILDCARD_XP_THRESHOLD=0.85
WILDCARD_BGW_MIN_PLAYERS=4
FREE_HIT_BGW_MIN_STARTERS=5
TRIPLE_CAPTAIN_XP_MULTIPLIER=1.6
BENCH_BOOST_MIN_BENCH_XP=20.0

# ── xP model weights (overridden by learned weights after GW 5) ───────────────
XP_WEIGHT_XG=1.0
XP_WEIGHT_XA=1.0
XP_WEIGHT_CS=1.0
XP_WEIGHT_FDR=0.15
